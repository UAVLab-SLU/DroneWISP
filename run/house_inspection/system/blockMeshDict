FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (-10 -40 0) // 0
    (30 -40 0)   // 1
    (30  40 0)   // 2
    (-10  40 0)  // 3
    (-10 -40 40) // 4
    (30 -40 40)  // 5
    (30  40 40)  // 6
    (-10 40 40) // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 80 40) simpleGrading (1 1 1)
);

boundary
(
    front
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    back
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
    lowerWall
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    upperWall
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
);

