FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/initialConditions"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $turbulentKE;

boundaryField
{
    //- Set patchGroups for constraint patches
    #includeEtc "caseDicts/setConstraintTypes"

    //- Define inlet conditions
    inlet
    {
        type            fixedValue;
        value           uniform 0.375;
    }

    front
    {
        type            zeroGradient;
    }

    back
    {
        type            fixedValue;
        value           uniform 0.375;
    }

    outlet
    {
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    combinedGroup
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    upperWall
    {
        type            zeroGradient;
    }
}


