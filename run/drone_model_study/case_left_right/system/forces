forces1
{
    type            forces;

    libs            ("libforces.so");

    writeControl    timeStep;
    timeInterval    1;

    log             yes;

    patches         (combined);
    rho             rhoInf;
    rhoInf          1.225;
    CofR            (0 0 0);
    // Reference values for coefficient calculation (optional)
    pRef            0;
    lRef            1;
    Aref            1;
}

